float mitsuyasu_spreading(float2 k_vec, float windDirection) {
	return 0.0;
}

kernel[32, 32, 1] mitsuyasuSpreading(g_id : GlobalInvocationID, int texSize, float strength) {
	if (g_id.x >= texSize) return;
	if (g_id.y >= texSize) return;
	if (g_id.z >= paramsBuffer.numCascades) return;
	
	int2 id = int2(g_id.xy);
	const int cascade_index = int(g_id.z);
	const float tile_length = paramsBuffer.tileLengths[cascade_index];
	
	float base_sample = imageLoad(spectrumMap, int3(id, cascade_index)).r;
	float2 coeffs = imageLoad(spectrumCoefficients, int3(id, cascade_index)).rg;
	float2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
	
	float no_spread_spectrum = base_sample / (2.0 * PI);
	float direction_spectrum = base_sample * mitsuyasu_spreading(k_vec, paramsBuffer.windDirection);
	float output_coeff = sqrt(mix(no_spread_spectrum, direction_spectrum, strength)) * (2.0 * PI / tile_length) / sqrt(2.0);
	imageStore(baseSpectrum, int3(id, cascade_index), float4(output_coeff * coeffs.x, output_coeff * coeffs.y, 0.0, 1.0));
}

float donelan_banner_spreading(float2 k_vec, float omega_peak, float depth, float windDirection) {
	float wave_direction = atan(k_vec.y, k_vec.x);
	float theta = wave_direction - windDirection;
	float tan_k = 0.0;
	float omega = dispersion_relation(length(k_vec), depth, tan_k);
	float omega_ratio = omega / omega_peak;
	float epsilon = -0.4 + 0.8393 * exp(-0.567 * log(omega_ratio * omega_ratio));
	float B_s = pow(10.0, epsilon);
	if (omega_ratio < 0.95) {
		B_s = 2.61 * pow(omega_ratio, 1.3);	
	} else if (omega_ratio < 1.6) {
		B_s = 2.28 * pow(omega_ratio, -1.3);	
	}

	float cosh_term = cosh(B_s * theta);
	float sech_term = 0.0;
	if (cosh_term != 0.0) {
		sech_term = 1.0 / cosh_term;
	}
	

	return B_s / (2.0 * tanh(B_s * PI)) * sech_term * sech_term;
	
}

kernel[32, 32, 1] donelanBannerSpreading(g_id : GlobalInvocationID, int texSize, float strength) {
	if (g_id.x >= texSize) return;
	if (g_id.y >= texSize) return;
	if (g_id.z >= paramsBuffer.numCascades) return;
	int2 id = int2(g_id.xy);
	const int cascade_index = int(g_id.z);
	const float tile_length = paramsBuffer.tileLengths[cascade_index];

	float base_sample = imageLoad(spectrumMap, int3(id, cascade_index)).r;
	float2 coeffs = imageLoad(spectrumCoefficients, int3(id, cascade_index)).rg;
	float2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
	
	float no_spread_spectrum = base_sample / (2.0 * PI);
	float direction_spectrum = base_sample * donelan_banner_spreading(k_vec, spectrumData.omega_peak, paramsBuffer.depth, paramsBuffer.windDirection);
	float output_coeff = sqrt(mix(no_spread_spectrum, direction_spectrum, strength)) * (2.0 * PI / tile_length) / sqrt(2.0);
	float2 out_values = output_coeff * coeffs;
	imageStore(baseSpectrum, int3(id, cascade_index), float4(out_values, 0.0, 1.0));
}