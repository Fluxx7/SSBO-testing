#include "shared_resources.fsl"

layout(rgba32f) uniform image2D spectrumCoefficients;

kernel[16, 16, 1] noSpreading {
	set 0 {
		baseSpectrum[restrict],
		spectrumCoefficients[restrict, readonly]
	}
	
	main(int texSize, float tile_length, float windDirection) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		float base_sample = imageLoad(baseSpectrum, id).r;
		vec2 coeffs = imageLoad(spectrumCoefficients, id).rg;
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		float direction_spectrum = base_sample / (2.0 * PI);
		float output_coeff = sqrt(direction_spectrum) * (2.0 * PI / tile_length) / sqrt(2.0);
		imageStore(baseSpectrum, id, vec4(output_coeff * coeffs.x, output_coeff * coeffs.y, 0.0, 1.0));
	}
}

float positive_cos_spreading(vec2 k_vec, float windDirection) {
    float wave_direction = atan(k_vec.y, k_vec.x);
    float theta = wave_direction - windDirection;
    if (abs(theta) > (PI / 2.0)) {
        return 0.0;
    }
    return 2.0 * pow(cos(theta), 2.0) / PI;
}

kernel[16, 16, 1] positiveCosSpreading {
	set 0 {
		baseSpectrum[restrict],
		spectrumCoefficients[restrict, readonly]
	}
	
	main(int texSize, float tile_length, float windDirection) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		float base_sample = imageLoad(baseSpectrum, id).r;
		vec2 coeffs = imageLoad(spectrumCoefficients, id).rg;
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		float direction_spectrum = base_sample * positive_cos_spreading(k_vec, windDirection);
		float output_coeff = sqrt(direction_spectrum) * (2.0 * PI / tile_length) / sqrt(2.0);
		imageStore(baseSpectrum, id, vec4(output_coeff * coeffs.x, output_coeff * coeffs.y, 0.0, 1.0));
	}
}
