layout(rgba16f) uniform image2D waveTexture;

kernel[2, 1, 1] textureGen(id : GlobalInvocationID, int waveCount, float baseSeed, float baseAmplitude, float baseFrequency, float lacunarity, float gain) {
    if (id.x >= waveCount) return;
    float multiplier = baseSeed * (id.x + 1);

    float dirX = sin(multiplier);
    float dirY = cos(multiplier);
    float amplitude = baseAmplitude * pow(lacunarity, id.x);
    float frequency = baseFrequency * pow(gain, id.x);
    float phase = cos(multiplier) * 10.0;
    imageStore(waveTexture, int2(gl_GlobalInvocationID.x, 0), float4(dirX, dirY, phase, 1.0));
    imageStore(waveTexture, int2(gl_GlobalInvocationID.x, 1), float4(amplitude, frequency, 0.0, 1.0));
}

kernel[2, 1, 1] textureGenAdv(id : GlobalInvocationID, int waveCount, float baseSeed, float baseAmplitude, float baseFrequency, float lacunarity, float gain) {
    if (id.x >= waveCount) return;
    float multiplier = baseSeed * (id.x + 1);
    float2 direction_flip = float2(sin(baseSeed), cos(baseSeed));
    float4 direction_lock = float4(-0.96, 0.96, -0.96, 0.96);
    if (direction_flip.x <= 0.0) {
        if (direction_flip.y <= 0.0) {
            direction_lock.x = direction_flip.x;
            direction_lock.y = 1.0 + direction_flip.x;
            direction_lock.z = direction_flip.y;
            direction_lock.w = 1.0 + direction_flip.y;
        } else {
            direction_lock.x = 1.0 - direction_flip.y;
            direction_lock.y = direction_flip.y;
            direction_lock.z = direction_flip.x;
            direction_lock.w = 1.0 + direction_flip.x;
        }
    } else {
        if (direction_flip.y <= 0.0) {
            direction_lock.x = direction_flip.y;
            direction_lock.y = 1.0 + direction_flip.y;
            direction_lock.z = 1.0 - direction_flip.x;
            direction_lock.w = direction_flip.x;
        } else {
            direction_lock.x = 1.0 - direction_flip.x;
            direction_lock.y = direction_flip.x;
            direction_lock.z = 1.0 - direction_flip.y;
            direction_lock.w = direction_flip.y;
        }
    }

    float2 direction_determinant = float2((direction_lock.x + direction_lock.y) * 0.5, (direction_lock.z + direction_lock.w) + 0.5);
    float2 direction_distribution = float2(abs(direction_lock.x - direction_determinant.x), abs(direction_lock.z - direction_determinant.y));

    float dirX = sin(multiplier)*direction_distribution.x + direction_determinant.x;
    float dirY = cos(multiplier)*direction_distribution.y + direction_determinant.y;
    float amplitude = baseAmplitude * pow(lacunarity, id.x);
    float frequency = baseFrequency * pow(gain, id.x);
    float phase = cos(multiplier) * 10.0;
    imageStore(waveTexture, int2(id.x, 0), float4(dirX, dirY, phase, 1.0));
    imageStore(waveTexture, int2(id.x, 1), float4(amplitude, frequency, 0.0, 1.0));
}