#include "shared_resources.fsl"
//#define USE_NORMALIZATION

layout(std430) buffer twiddleFactors {
    float2 twiddles[];
};

layout(std430) buffer fft_buffers {
    float4 fft_data[][2][MAX_CASCADES];
};

#define fft_index(x, y, b) fft_data[ x + y * N][ b ][cascade_index] 
#define fft_vindex(v, b) fft_data[ v.x + v.y * N][ b ][cascade_index]  


#define dest(index) fft_index( index , y_coord, curr_dest)
#define source(index) fft_index( index , y_coord, curr_source)

kernel[32, 1, 1] twiddleGen(id : GlobalInvocationID, uint N) {
	if (id.x >= (N / 2)) return;
	uint x = id.x;
	float theta = 2.0 * PI * float(x) / float(N);
	twiddles[x] = float2(cos(theta), sin(theta));
}

kernel[32, 32, 1] ifftStage(id : GlobalInvocationID, uint N, uint stage, uint curr_source, uint curr_dest) {
	uint x_coord = id.x;
	uint y_coord = id.y;
	if (x_coord >= N/2 || y_coord >= N || id.z >= MAX_CASCADES) {
		return;
	}
	const int cascade_index = int(id.z);

	uint index_base = N >> (stage + 1);
	uint group_size = 1 << stage;
	uint group = x_coord & ~(group_size - 1);
	uint group_index = x_coord & (group_size - 1);
	
	// compute the indices to read from
	uint source_index_1 = x_coord;
	uint source_index_2 = source_index_1 + N/2;

	// compute the indices to write to
	uint dest_index_1 = x_coord + group; 
	uint dest_index_2 = dest_index_1 + group_size;

	// calculate the twiddle factor index to read from and retrieve that value 
	uint twiddle_index = (source_index_1 & (group_size - 1)) * index_base;
	float2 twiddle = twiddles[twiddle_index];


	// load and twiddle the "odd" value, and load the "even" value
	float2 twiddled_x = complex_mult(twiddle, source(source_index_2).xy);
	float2 even_x = source(source_index_1).xy;
	float2 twiddled_y = complex_mult(twiddle, source(source_index_2).zw);
	float2 even_y = source(source_index_1).zw;
	

	// calculate the output values and write them to the determined indices
#ifdef USE_NORMALIZATION
	dest(dest_index_2) = float4(complex_mult(even_x - twiddled_x, 0.5), complex_mult(even_y - twiddled_y, 0.5));
	dest(dest_index_1) = float4(complex_mult(even_x + twiddled_x, 0.5), complex_mult(even_y + twiddled_y, 0.5));
#else
	dest(dest_index_2) = float4(even_x - twiddled_x, even_y - twiddled_y);
	dest(dest_index_1) = float4(even_x + twiddled_x, even_y + twiddled_y);
#endif
}

kernel[32, 32, 1] ifftTranspose(id : GlobalInvocationID, uint N, uint curr_source, uint curr_dest) {
	uint x_coord = id.x;
	uint y_coord = id.y;
	if (x_coord >= N || y_coord >= N || id.z >= MAX_CASCADES) {
		return;
	}
	const int cascade_index = int(id.z);
	
	fft_index(y_coord, x_coord, curr_dest) = fft_index(x_coord, y_coord, curr_source);
}


