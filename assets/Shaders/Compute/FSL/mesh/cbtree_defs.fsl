#include "mesh_common.fsl"

layout(std430) buffer IndirectDispatchBuffer : flag_indirect {
	u32 x;
	u32 y;
	u32 z;	
} indirect_dispatch;

struct HalfEdge {
    i32 twin;
    i32 next;
    i32 prev;
    i32 vert;
    i32 edge;
    i32 face;
};

layout(std430) buffer HalfEdgeBuffer {
	u32 num_half_edges;
    HalfEdge[] half_edges;
};

layout(std430) buffer VertexInputBuffer : godot_vertex {
	Vertex[] root_vertices;
};

struct Bisector {
    i32 next;
    i32 prev;
    i32 twin;
    i64 j_index;
    i32 command;
    i32 empty_mem_0;
    i32 empty_mem_1;
    i32 empty_mem_2;
    i32 empty_mem_3;
};

layout(std430) buffer BisectorBuffer {
	u64 num_bisectors;
    Bisector[] bisectors;
};

layout(std430) buffer CBTreeBuffer {
    i32[] data;
} cbtree;

layout(std430) buffer CBTDataBuffer {
	u32 cbt_depth;
	u32 pow_2_cbt_depth;
	u32 counter;	
    u32x2[] pointers; 
};

f32x3 vertex_to_f32x3(Vertex vertex) {
	return f32x3(vertex.x, vertex.y, vertex.z);
}

Vertex f32x3_to_vertex(f32x3 vertex_src) {
	return Vertex(vertex_src.x, vertex_src.y, vertex_src.z);	
}

f32x3x3 root_bisector_vertices(i32 halfedgeID) {
	i32 nextID = half_edges[halfedgeID].next;
	i32 v0_id = half_edges[halfedgeID].vert;
	i32 v1_id = half_edges[nextID].vert;
	f32x3 v0 = vertex_to_f32x3(root_vertices[v0_id]);
	f32x3 v1 = vertex_to_f32x3(root_vertices[v1_id]);
	f32x3 v2 = v0;
	i32 n = 1;
	i32 h = nextID;
	while (h != halfedgeID) {
		v2 += vertex_to_f32x3(root_vertices[half_edges[h].vert]);
		n++;
		h = half_edges[h].next;
	}
	v2 /= n;
	return f32x3x3(v0, v1, v2);
}

i32x3 bisector_vertices(Bisector b_dj) {
	return i32x3(0, 0, 0);
}

i32 one_to_bit_id(i32 index) {
	i32 bitID = 1;
	while (bitID < pow_2_cbt_depth) {
		bitID *= 2;
		if (index >= cbtree.data[bitID]) {
			index -= cbtree.data[bitID];
			bitID++;
		}
	}
	return bitID - pow_2_cbt_depth;
}

