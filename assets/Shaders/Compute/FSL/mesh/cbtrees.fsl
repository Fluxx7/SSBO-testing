#include "cbtree_defs.fsl"

void update_dispatch_buffer() {
	indirect_dispatch.x = u32(cbtree.data[0]);
	indirect_dispatch.y = 1;
	indirect_dispatch.z = 1;
}

kernel[1, 1, 1] resetCounter() {
    counter = 0;
    update_dispatch_buffer();
}

