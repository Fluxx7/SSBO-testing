kernel[16, 16, 1] sumReduction(g_id : GlobalInvocationID) {

}

kernel[1, 1, 1] initBuffers(_g_id : GlobalInvocationID, f32 sizeX, f32 sizeY, u32 cbt_depth_in, i32 base_mesh_divisions) {
	i32x3 g_id = i32x3(_g_id);
	i32 max_id = base_mesh_divisions - 1;
	
	i32 face = g_id.x + g_id.y * base_mesh_divisions;
	i32 verts_per_row = base_mesh_divisions + 1;
	i32 v_tl = g_id.x + g_id.y * verts_per_row;	
	i32 v_tr = 1 + g_id.x + g_id.y * verts_per_row;
	i32 v_bl = g_id.x + (g_id.y + 1) * verts_per_row;	
	i32 v_br = 1 + g_id.x + (g_id.y + 1) * verts_per_row;	
	
	i32 e_top = g_id.x + g_id.y * (2 * verts_per_row);
	i32 e_left = e_top + base_mesh_divisions;
	i32 e_bottom = g_id.x + (g_id.y + 1) * (2 * verts_per_row);
	i32 e_right = e_left + 1;
	
	i32 he_top_id = 4 * face;
	i32 he_right_id = he_top_id + 1;
	i32 he_bottom_id = he_top_id + 2;
	i32 he_left_id = he_top_id + 3;
	
	HalfEdge he_top;
	he_top.face = face;
	he_top.edge = e_top;
	he_top.vert = v_tl;
	he_top.twin = g_id.y > 0 ? (4 * (face - base_mesh_divisions) + 2) : -1;
	he_top.next = he_right_id;
	he_top.prev = he_left_id;
	
	HalfEdge he_right;
	he_right.face = face;
	he_right.edge = e_right;
	he_right.vert = v_tr;
	he_right.twin = g_id.x < max_id ? (4 * (face + 1) + 3) : -1;
	he_right.next = he_bottom_id;
	he_right.prev = he_top_id;
	
	HalfEdge he_bottom;
	he_bottom.face = face;
	he_bottom.edge = e_bottom;
	he_bottom.vert = v_br;
	he_bottom.twin = g_id.y < max_id ? (4 * (face + base_mesh_divisions)) : -1;
	he_bottom.next = he_left_id;
	he_bottom.prev = he_right_id;
	
	HalfEdge he_left;
	he_left.face = face;
	he_left.edge = e_left;
	he_left.vert = v_bl;
	he_left.twin = g_id.x > 0 ? (4 * (face - 1) + 1) : -1;
	he_left.next = he_top_id;
	he_left.prev = he_bottom_id;
    
    half_edges[he_top_id] = he_top;
    half_edges[he_right_id] = he_right;
    half_edges[he_bottom_id] = he_bottom;
    half_edges[he_left_id] = he_left;
    
    const f32x2 size = f32x2(sizeX, sizeY);
	const f32x2 step = size / f32(verts_per_row - 1);
	
	const f32 half_size = f32(verts_per_row - 1) * 0.5;
    
    root_vertices[v_tl] = Vertex((f32(_g_id.x) - half_size) * step.y, 0.0, (f32(_g_id.y) - half_size) * step.x);
    if (g_id.x == max_id) {
		root_vertices[v_tr] = Vertex((f32(_g_id.x + 1) - half_size) * step.y, 0.0, (f32(_g_id.y) - half_size) * step.x);
	}
	if (g_id.y == max_id) {
		root_vertices[v_bl] = Vertex((f32(_g_id.x) - half_size) * step.y, 0.0, (f32(_g_id.y + 1) - half_size) * step.x);
	}
    if (g_id == i32x3(max_id, max_id, 0)) {
		root_vertices[v_br] = Vertex((f32(_g_id.x + 1) - half_size) * step.y, 0.0, (f32(_g_id.y + 1) - half_size) * step.x);
	}
	if (_g_id == u32x3(0, 0, 0)) {
		num_half_edges = 4 * base_mesh_divisions * base_mesh_divisions;
	}
}

kernel[1, 1, 1] postHalfEdge(g_id : GlobalInvocationID, u32 cbt_depth_in) {
	if (g_id.x > 0 || g_id.y > 0 || g_id.z > 0) return;
	cbt_depth = cbt_depth_in;
	pow_2_cbt_depth = 1u << cbt_depth_in;
	indirect_dispatch.x = (num_half_edges + 31u) / 32u;
	indirect_dispatch.y = 1;
	indirect_dispatch.z = 1;
}

kernel[32, 1, 1] makeRootBisectors(g_id : GlobalInvocationID) {
	if (g_id.x >= num_half_edges) return;
	HalfEdge he = half_edges[g_id.x];
	
	Bisector bis;
	bis.next = he.next;
	bis.prev = he.prev;
	bis.twin = he.twin;
	bis.j_index = g_id.x;
	bis.command = 0;
	bis.empty_mem_0 = 0;
	bis.empty_mem_1 = 0;
	bis.empty_mem_2 = 0;
	bis.empty_mem_3 = 0;
	bisectors[g_id.x] = bis;
	
	if (g_id.x == 0) {
		num_bisectors = num_half_edges;
		indirect_dispatch.x = (num_half_edges + 31u) / 32u;
		indirect_dispatch.y = 1;
		indirect_dispatch.z = 1;
	}
}

kernel[32, 1, 1] buildTris(g_id : GlobalInvocationID) {
	if (g_id.x >= num_bisectors) return;
	f32x3x3 vertices = root_bisector_vertices(i32(g_id.x));
	Vertex v0 = f32x3_to_vertex(vertices[0]);
	Vertex v1 = f32x3_to_vertex(vertices[1]);
	Vertex v2 = f32x3_to_vertex(vertices[2]);
	u32 v0_index = 3 * g_id.x;
	u32 v1_index = v0_index + 1;
	u32 v2_index = v0_index + 2;
	vertex_buffer.data[v0_index] = v0;
	vertex_buffer.data[v1_index] = v1;
	vertex_buffer.data[v2_index] = v2;
	index_buffer.data[g_id.x] = Index(v0_index, v1_index, v2_index); 
	
	if (g_id.x == 0) {
		draw_command_buffer.index_count = u32(num_bisectors) * 3;
		draw_command_buffer.instance_count = 1;
		draw_command_buffer.first_index = 0;
		draw_command_buffer.vertex_offset = 0;
		draw_command_buffer.first_instance = 0;	
	}
}