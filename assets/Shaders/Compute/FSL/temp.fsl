#include "shared_resources.fsl"

kernel[1, 1, 1] updateParams(uint numCascades, float windSpeed, float windDirection, float depth, float fetch) {
	paramsBuffer.numCascades = numCascades;
	paramsBuffer.windSpeed = windSpeed;
	paramsBuffer.windDirection = windDirection;
	paramsBuffer.depth = depth;
	paramsBuffer.fetch = fetch;
}

kernel[1, 1, 1] updateCascadeParam(uint cascade_index, float param_x, float param_y, float param_z) {
	paramsBuffer.cascadeParams[cascade_index] = float4(param_x, param_y, param_z, 1.0);
}