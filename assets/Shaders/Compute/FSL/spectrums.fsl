#include "shared_resources.fsl"

float gamma_function() {
	return 0.0;
}

float get_kmag(int2 id, int cascade_index, int texSize, float tile_length) {
	return length(2.0 * PI * (id - texSize * 0.5) / tile_length);
}

float tessendorf_spectrum(float A, float k, float windSpeed) {
    float kRcp = 0.0;
    if (k > 1e-6) {
        kRcp = 1.0/k;
    }
    return A * exp( -1.0f * g * g / pow(windSpeed, 4.0) * kRcp * kRcp) * pow(kRcp, 4.0);
}

kernel[32, 32, 1] tessendorfSpectrum(g_id : GlobalInvocationID, float A) {
	if (g_id.x >= N) return;
	if (g_id.y >= N) return;
	if (g_id.z >= paramsBuffer.numCascades) return;
	
	const int texSize = int(N);
	int2 id = int2(g_id.xy);
	const int cascade_index = int(g_id.z);
	const float tile_length = paramsBuffer.cascadeParams[cascade_index].x;

	float k = get_kmag(id, cascade_index, texSize, tile_length);
	imageStore(spectrumMap, int3(id, cascade_index), float4(tessendorf_spectrum(A, k, paramsBuffer.windSpeed), 0.0, 0.0, 1.0));
}

kernel[32, 32, 1] attenuatedTessendorfSpectrum(g_id : GlobalInvocationID, float A, float l) {
	if (g_id.x >= N) return;
	if (g_id.y >= N) return;
	if (g_id.z >= paramsBuffer.numCascades) return;
	const int texSize = int(N);
	int2 id = int2(g_id.xy);
	const int cascade_index = int(g_id.z);
	const float tile_length = paramsBuffer.cascadeParams[cascade_index].x;

	float k = get_kmag(id, cascade_index, texSize, tile_length);
	float attenuation = exp(-(k * k) * (l * l));
	imageStore(spectrumMap, int3(id, cascade_index), float4(tessendorf_spectrum(A, k, paramsBuffer.windSpeed) * attenuation, 0.0, 0.0, 1.0));
}

float dphi_dk(float k_mag, float omega, float depth, float tan_k) {
    if (omega < 1e-6 || k_mag < 1e-6) {
        return 0.0;
    }
    float sech2 = 1.0 - tan_k * tan_k;
    float dfdk  = depth + 3.0 * k_mag * k_mag * water_surface_tension / water_density;
    float domega_dk = (g * tan_k + g * k_mag * sech2 * dfdk) / (2.0 * omega);
    return domega_dk / k_mag;
}

float a_b_spectrum(float omega, float A, float B) {
    float omegaRcp = 0.0;
    if (omega > 1e-6) {
        omegaRcp = 1.0 / omega;
    }
    float first_term = A * pow(omegaRcp, 5.0);
    float second_term = exp(-B * pow(omegaRcp, 4.0));
   
    return first_term * second_term;
}

kernel[32, 32, 1] abSpectrum(g_id : GlobalInvocationID, float A, float B) {
	if (g_id.x >= N) return;
	if (g_id.y >= N) return;
	if (g_id.z >= paramsBuffer.numCascades) return;
	
	const int texSize = int(N);
	int2 id = int2(g_id.xy);
	const int cascade_index = int(g_id.z);
	const float tile_length = paramsBuffer.cascadeParams[cascade_index].x;

	float k_mag = get_kmag(id, cascade_index, texSize, tile_length);
	float tan_k = 0.0;
	float omega = dispersion_relation(k_mag, paramsBuffer.depth, tan_k);
	imageStore(spectrumMap, int3(id, cascade_index), float4(a_b_spectrum(omega, A, B) * dphi_dk(k_mag, omega, paramsBuffer.depth, tan_k), 0.0, 0.0, 1.0));
}

float2 jonswap_spectrum(float omega, float windSpeed, float fetch) {
    const float a = 0.076 * pow(windSpeed * windSpeed / (fetch * g), 0.22);
    const float peak_enhancement = 3.3f;
    const float omega_peak = 22.0 * pow(g * g / (windSpeed * fetch), 1.0/3.0);

    const float sigma = omega > omega_peak ? 0.09 : 0.07;
    const float r = exp(- pow(omega - omega_peak, 2.0) / (2.0 * sigma * sigma * omega_peak * omega_peak));

    float A = a * g * g;
    float B = 5.0/4.0 * pow(omega_peak, 4.0);
   
    return float2(a_b_spectrum(omega, A, B) * pow(peak_enhancement, r), omega_peak);
}

kernel[32, 32, 1] jonswapSpectrum(g_id : GlobalInvocationID) {
    if (g_id.x >= N) return;
    if (g_id.y >= N) return;
    if (g_id.z >= paramsBuffer.numCascades) return;
    const int texSize = int(N);
    int2 id = int2(g_id.xy);
    const int cascade_index = int(g_id.z);
    const float tile_length = paramsBuffer.cascadeParams[cascade_index].x;

    float k_mag = get_kmag(id, cascade_index, texSize, tile_length);
    float tan_k = 0.0;
    float omega = dispersion_relation(k_mag, paramsBuffer.depth, tan_k);
    float2 jonswap_results = jonswap_spectrum(omega, paramsBuffer.windSpeed, paramsBuffer.fetch);
    spectrumData.omega_peak = jonswap_results.y;
    imageStore(spectrumMap, 
    	int3(id, cascade_index), 
    	float4(jonswap_results.x * dphi_dk(k_mag, omega, paramsBuffer.depth, tan_k), 
    	0.0, 0.0, 1.0));
}


float depth_attenuation(float omega, float depth) {
    float w_h = omega * sqrt(depth/g);

    if (w_h >= 2.0) {
        return 1.0;
    } else if (w_h > 1.0) {    
        return 1.0 - 0.5 * (2.0 - w_h) * (2.0 - w_h);
    } else {
        return 0.5 * w_h * w_h;
    }
}

kernel[32, 32, 1] tmaSpectrum(g_id : GlobalInvocationID) {
    if (g_id.x >= N) return;
    if (g_id.y >= N) return;
    if (g_id.z >= paramsBuffer.numCascades) return;
    
    const int texSize = int(N);
    int2 id = int2(g_id.xy);
    const int cascade_index = int(g_id.z);
    const float tile_length = paramsBuffer.cascadeParams[cascade_index].x;

    float k_mag = get_kmag(id, cascade_index, texSize, tile_length);
    float tan_k = 0.0;
    float omega = dispersion_relation(k_mag, paramsBuffer.depth, tan_k);
    float2 tma_results = jonswap_spectrum(omega, paramsBuffer.windSpeed, paramsBuffer.fetch) 
    					* depth_attenuation(omega, paramsBuffer.depth);
	spectrumData.omega_peak = tma_results.y;
    imageStore(spectrumMap, 
    	int3(id, cascade_index), 
    	float4(tma_results.x * dphi_dk(k_mag, omega, paramsBuffer.depth, tan_k), 
    	0.0, 0.0, 1.0));
}
