#include "shared_resources.fsl"

float tessendorf_spectrum(float A, vec2 k_vec) {
    float k = length(k_vec);
    float kRcp = 0.0;
    if (k > 1e-6) {
        kRcp = 1.0/k;
    }
    return A * exp( -1.0f * g * g / pow(windSpeed, 4.0) * kRcp * kRcp) * pow(kRcp, 4.0);
}

kernel[16, 16, 1] tessendorfSpectrum {
	set 0 {
		baseSpectrum[restrict, writeonly]
	}
	
	main(int texSize, float windSpeed, float A, float tile_length) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		imageStore(baseSpectrum, id, vec4(tessendorf_spectrum(A, k_vec), 0.0, 0.0, 1.0));
	}
}

float dphi_dk(float k_mag, float omega, float depth, float tan_k) {
    if (omega < 1e-6 || k_mag < 1e-6) {
        return 0.0;
    }
    float sech2 = 1.0 - tan_k * tan_k;
    float dfdk  = depth + 3.0 * k_mag * k_mag * water_surface_tension / water_density;
    float domega_dk = (g * tan_k + g * k_mag * sech2 * dfdk) / (2.0 * omega);
    return domega_dk / k_mag;
}

float a_b_spectrum(float omega) {
    float omegaRcp = 0.0;
    if (omega > 1e-6) {
        omegaRcp = 1.0 / omega;
    }
    float first_term = A * pow(omegaRcp, 5.0);
    float second_term = exp(-B * pow(omegaRcp, 4.0));
   
    return first_term * second_term;
}

kernel[16, 16, 1] abSpectrum {
	set 0 {
		baseSpectrum[restrict, writeonly]
	}
	
	main(int texSize, float tile_length, float A, float B, float depth) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		float k_mag = length(k_vec);
		float tan_k = 0.0;
		float omega = dispersion_relation(k_mag, depth, tan_k);
		float k_rcp = 0.0;
		if (k_mag > 1e-6) {
			k_rcp = 1.0 / k_mag;
		}
		imageStore(baseSpectrum, id, vec4(a_b_spectrum(omega) * dphi_dk(k_mag, omega, depth, tan_k) * k_rcp, 0.0, 0.0, 1.0));
 	}
}

float jonswap_spectrum(float omega) {
    const float a = 0.076 * pow(windSpeed * windSpeed / (fetch * g), 0.22);
    const float peak_enhancement = 3.3f;
    const float omega_peak = 22.0 * pow(g * g / (windSpeed * fetch), 1.0/3.0);

    const float sigma = omega > omega_peak ? 0.09 : 0.07;
    const float r = exp(- pow(omega - omega_peak, 2.0) / (2.0 * sigma * sigma * omega_peak * omega_peak));

    float A = a * g * g;
    float B = 5.0/4.0 * pow(omega_peak, 4.0);
   
    return a_b_spectrum(omega, A, B) * pow(peak_enhancement, r);
}

kernel[16, 16, 1] jonswapSpectrum {
	set 0 {
		baseSpectrum[restrict, writeonly]
	}
	
	main(int texSize, float windSpeed, float fetch, float depth, float tile_length) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		float k_mag = length(k_vec);
		float tan_k = 0.0;
		float omega = dispersion_relation(k_mag, depth, tan_k);
		float k_rcp = 0.0;
		if (k_mag > 1e-6) {
			k_rcp = 1.0 / k_mag;
		}
		imageStore(baseSpectrum, id, vec4(jonswap_spectrum(omega) * dphi_dk(k_mag, omega, depth, tan_k) * k_rcp, 0.0, 0.0, 1.0));
 	}
}

float depth_attenuation(float omega, float depth) {
    float w_h = omega * sqrt(depth/g);

    if (w_h >= 2.0) {
        return 1.0;
    } else if (w_h > 1.0) {    
        return 1.0 - 0.5 * (2.0 - w_h) * (2.0 - w_h);
    } else {
        return 0.5 * w_h * w_h;
    }
}

kernel[16, 16, 1] tmaSpectrum{
	set 0 {
		baseSpectrum[restrict, writeonly]
	}
	
	main(int texSize, float windSpeed, float fetch, float depth, float tile_length) {
		if (gl_GlobalInvocationID.x >= texSize) return;
		if (gl_GlobalInvocationID.y >= texSize) return;
		ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	
		vec2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
		float k_mag = length(k_vec);
		float tan_k = 0.0;
		float omega = dispersion_relation(k_mag, depth, tan_k);
		float k_rcp = 0.0;
		if (k_mag > 1e-6) {
			k_rcp = 1.0 / k_mag;
		}
		imageStore(baseSpectrum, id, vec4(jonswap_spectrum(omega) * depth_attenuation(omega, depth) * dphi_dk(k_mag, omega, depth, tan_k) * k_rcp, 0.0, 0.0, 1.0));
	}
}