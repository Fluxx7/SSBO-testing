#define MAX_CASCADES 4

const float PI = 3.1415926535897932384626433;
const float g = 9.81;
const float water_surface_tension = 0.074;
const float water_density = 1000.0;

float2 complex_mult(float2 a, float2 b) {
    return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

float2 complex_mult(float a, float2 b) {
    return float2(a * b.x, a * b.y );
}

float2 complex_mult(float2 a, float b) {
    return float2(a.x * b, a.y * b );
}

float2 complex_conj(float2 num) {
    num.y *= -1.0;
    return num;
}

float2 exp_j(float theta) {
    return float2(cos(theta), sin(theta));
}

layout(rgba32f) uniform image2DArray spectrumMap;
layout(rgba32f) uniform image2DArray baseSpectrum;
layout(rgba32f) uniform image2DArray spectrumTexture;

layout(std430) buffer oceanParams {
	uint numCascades;
	float windSpeed;
	float windDirection;
	float depth;
	float fetch;
	float tileLengths[];
} paramsBuffer;

layout(std430) buffer spectrumDataBuffer {
	float omega_peak;
} spectrumData;

float dispersion_relation(float k_mag, float depth, out float tan_k) {
    tan_k = tanh(k_mag * depth);
    return sqrt(g * k_mag * tan_k + pow(k_mag, 3.0) * water_surface_tension / water_density);
}